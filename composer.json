{
    "name": "kirsky/tgt-task",
    "description": "Новичок — как договаривались: договорённости с новичком как задачи Битрикс24 + подтверждение в Telegram",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "nutgram/nutgram": "^4.51",
        "chillerlan/php-qrcode": "^5.0"
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "check": [
            "@stan",
            "@test"
        ]
    }
}
